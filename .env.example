# Copy to .env.local (never commit it). On Vercel, add the same keys under Project → Settings → Environment Variables.
# Sign-in passwords for the two learners. Checked only on the server; never sent to the browser or stored anywhere else.
SEED_PASSWORD_ADITYA=
SEED_PASSWORD_HARSH=Harsh@2804

# Optional: a long random string used to sign session cookies. If empty, a key is derived from the passwords
# (so changing a password signs everyone out).
# SESSION_SECRET=

# Optional (local only)
# SYLLABUS_DIR=./syllabus
